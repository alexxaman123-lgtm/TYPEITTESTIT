---
import "../index.css";
import { THEMES, DEFAULT_THEME } from "../lib/themes";
import { LOCALES, LOCALE_META, withLocalePrefix, type Locale } from "../lib/i18n";

export type PageKey =
  | "home"
  | "about"
  | "contact"
  | "leaderboard"
  | "privacy-policy"
  | "terms-of-use"
  | "account";

const PAGE_ROOT_PATH: Record<PageKey, string> = {
  home: "/",
  about: "/about/",
  contact: "/contact/",
  leaderboard: "/leaderboard/",
  "privacy-policy": "/privacy-policy/",
  "terms-of-use": "/terms-of-use/",
  account: "/account/",
};

interface AlternateLink {
  hreflang: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  /** Preferred: drives canonical + reciprocal hreflang generation for all 13 locales automatically. */
  pageKey?: PageKey;
  /** Legacy/manual override. Not needed when pageKey is supplied. */
  canonicalPath?: string;
  structuredData?: Record<string, unknown>[];
  locale?: Locale;
  /** Legacy/manual override. Not needed when pageKey is supplied. */
  alternates?: AlternateLink[];
}

const {
  title,
  description,
  pageKey,
  canonicalPath,
  structuredData = [],
  locale = "en",
  alternates = [],
} = Astro.props;

const siteUrl = "https://typeittestit.com";
const meta = LOCALE_META[locale as Locale] ?? LOCALE_META.en;
const rootPath = pageKey ? PAGE_ROOT_PATH[pageKey] : undefined;
const resolvedCanonicalPath = canonicalPath ?? (rootPath ? withLocalePrefix(locale as Locale, rootPath) : "/");
const canonicalUrl = `${siteUrl}${resolvedCanonicalPath}`;
const localizedBrand = meta.brand;
const localizedImageAlt = `${meta.brand}, ${meta.imageAltSuffix}`;
const themeMap = Object.fromEntries(
  THEMES.map((theme) => [theme.id, { type: theme.type, variables: theme.variables }])
);

// The account page is a private, per-user dashboard (typing history, email,
// account info) that renders an empty sign-in prompt when logged out. It has
// no unique public content to rank for and should never be crawled/indexed,
// on any locale.
const isPrivatePage = pageKey === "account";
const robotsContent = isPrivatePage
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

// When a pageKey is provided, generate a complete, reciprocal 13-locale +
// x-default hreflang cluster automatically. This is the single place that
// knows about every locale, so adding a 14th language later means adding
// one entry to LOCALES/LOCALE_META in src/lib/i18n.ts -- nothing here needs
// to change. Private pages are excluded: hreflang clusters are a signal for
// content Google should index and swap between locales, which doesn't apply
// to a noindex page.
const generatedAlternates: AlternateLink[] = rootPath && !isPrivatePage
  ? [
      ...LOCALES.map((l) => ({ hreflang: LOCALE_META[l].htmlLang, href: `${siteUrl}${withLocalePrefix(l, rootPath)}` })),
      { hreflang: "x-default", href: `${siteUrl}${rootPath}` },
    ]
  : alternates;
const hreflangLinks = Array.from(new Map(generatedAlternates.map((alternate) => [alternate.hreflang, alternate])).values());

const ogLocaleAlternates = rootPath
  ? LOCALES.filter((l) => l !== locale).map((l) => LOCALE_META[l].bcp47.replace("-", "_"))
  : [];
---
<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <!-- Preserve the site's existing analytics bootstrap and AdSense integration. -->
    <script is:inline src="/ga-init.js"></script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-SGDYN5GEJT"></script>

    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9769426845506731" crossorigin="anonymous"></script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="author" content={localizedBrand} />
    <link rel="canonical" href={canonicalUrl} />
    {hreflangLinks.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={localizedBrand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={meta.bcp47.replace("-", "_")} />
    {ogLocaleAlternates.map((code) => <meta property="og:locale:alternate" content={code} />)}
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />
    <meta property="og:image:alt" content={localizedImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />
    <meta name="twitter:image:alt" content={localizedImageAlt} />

    <meta name="theme-color" content="#050706" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {structuredData.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}

    <script is:inline define:vars={{ themeMap, defaultTheme: DEFAULT_THEME }}>
      (() => {
        try {
          const saved = localStorage.getItem('goattype-theme-v5');
          const themes = themeMap;
          const theme = (saved && themes[saved]) ? themes[saved] : themes[defaultTheme];
          if (!theme) return;
          const root = document.documentElement;
          if (theme.type === 'dark') {
            root.classList.add('dark');
            root.style.colorScheme = 'dark';
          } else {
            root.classList.remove('dark');
            root.style.colorScheme = 'light';
          }
          Object.entries(theme.variables).forEach(([name, value]) => root.style.setProperty(name, value));
        } catch (_) {
          // Theme loading is cosmetic and must never block page rendering.
        }
      })();
    </script>
  </head>
  <body>
    <slot />
    <script is:inline>
      (() => {
        // Watch both plain [data-reveal] elements AND [data-reveal-group]
        // containers (e.g. the How It Works cards grid). These used to be
        // queried separately in different places; this single script is the
        // one that actually runs on every static/SSR'd page (including the
        // homepage and every localized route), so it must own both selectors
        // or a data-reveal-group element (which has no data-reveal attribute
        // of its own) never gets observed and its children stay at
        // opacity: 0 forever, per the [data-reveal-group] > * CSS rule.
        const elements = Array.from(document.querySelectorAll('[data-reveal], [data-reveal-group]'));
        if (!elements.length) return;
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reducedMotion || !('IntersectionObserver' in window)) {
          elements.forEach((element) => element.classList.add('reveal-visible'));
          return;
        }
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('reveal-visible');
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -8% 0px' });
        elements.forEach((element, index) => {
          element.style.setProperty('--reveal-index', String(index));
          observer.observe(element);
        });
      })();

      // Drive the large footer wordmark from the global Astro layout so it
      // works on both static and React-rendered pages, including every
      // localized route.
      (() => {
        const footers = Array.from(document.querySelectorAll('[data-footer-parallax]'));
        if (!footers.length) return;

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const update = () => {
          const viewport = window.innerHeight || 1;
          footers.forEach((footer) => {
            const wordmark = footer.querySelector('[data-footer-wordmark]');
            if (!wordmark) return;

            const rect = footer.getBoundingClientRect();
            const progress = Math.max(0, Math.min(1, (viewport - rect.top) / (viewport + rect.height)));
            const offset = reducedMotion ? 0 : 150 - progress * 300;
            wordmark.style.transform = `translate3d(-50%, ${offset.toFixed(1)}px, 0)`;
          });
        };

        let frame = 0;
        const onScroll = () => {
          if (frame) return;
          frame = window.requestAnimationFrame(() => {
            frame = 0;
            update();
          });
        };

        update();
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
      })();

      // Defer the large hero video until the page has finished loading so the
      // first render is not competing with a multi-megabyte media request.
      (() => {
        const loadDeferredVideos = () => {
          const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('[data-deferred-video]'));
          videos.forEach((video) => {
            const src = video.dataset.deferredVideo;
            if (!src || video.currentSrc || video.src) return;
            video.muted = true;
            video.defaultMuted = true;
            video.volume = 0;
            video.src = src;
            video.load();
            const play = () => {
              video.muted = true;
              video.volume = 0;
              void video.play().catch(() => {});
            };
            if (video.readyState >= 2) play();
            else video.addEventListener('loadeddata', play, { once: true });
          });
        };

        const schedule = () => {
          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(loadDeferredVideos, { timeout: 2000 });
          } else {
            window.setTimeout(loadDeferredVideos, 900);
          }
        };

        if (document.readyState === 'complete') schedule();
        else window.addEventListener('load', schedule, { once: true });
      })();

      // Gate infinite CSS animations behind viewport visibility so off-screen
      // sections (e.g. the typing motion showcase below the fold) don't burn
      // GPU compositor time on every page load.
      (() => {
        const motionElements = Array.from(document.querySelectorAll('[data-motion-defer]'));
        if (!motionElements.length) return;
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reducedMotion || !('IntersectionObserver' in window)) {
          motionElements.forEach((element) => element.setAttribute('data-motion-defer', 'active'));
          return;
        }
        const motionObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.setAttribute('data-motion-defer', 'active');
            motionObserver.unobserve(entry.target);
          });
        }, { rootMargin: '0px 0px 10% 0px' });
        motionElements.forEach((element) => motionObserver.observe(element));
      })();
    </script>
  </body>
</html>
