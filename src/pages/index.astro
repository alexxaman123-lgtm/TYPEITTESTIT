---
import SiteLayout from "../layouts/SiteLayout.astro";
import Header from "../components/Header";
import Hero from "../components/Hero";
import TypingTesterIsland from "../components/TypingTesterIsland";
import TypingMotionSection from "../components/TypingMotionSection";
import SeoContent from "../components/SeoContent";
import HowItWorks from "../components/HowItWorks";
import FaqSection from "../components/FaqSection";
import FaqSchema from "../components/FaqSchema";
import Footer from "../components/Footer";

const title = "Free Typing Test Online | 1-Minute WPM Speed Test | GOATTYPE";
const description = "Take a free online typing test to check WPM, typing speed, accuracy, and errors. Choose a 1, 2, 3, or 5 minute test and practice in 13 languages.";

const webApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "GOATTYPE",
  alternateName: ["Free Typing Test", "GOATTYPE Typing Test", "WPM Test", "Typing Speed Test"],
  url: "https://typeittestit.com/",
  applicationCategory: "UtilityApplication",
  applicationSubCategory: "Typing Test",
  operatingSystem: "Any",
  browserRequirements: "Requires a modern web browser with JavaScript enabled",
  featureList: [
    "Free online typing test",
    "1 minute typing test",
    "WPM typing speed test",
    "Typing accuracy test",
    "Typing practice in 13 languages",
    "1, 2, 3, and 5 minute test durations",
    "Custom typing test",
    "Easy, medium, and hard difficulty levels",
    "Live typing metrics",
  ],
  description: "GOATTYPE is a free online typing test for measuring typing speed in WPM, accuracy, and errors with timed practice in 13 languages.",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "GOATTYPE",
  alternateName: ["Free Typing Test", "WPM Test", "Typing Speed Test"],
  url: "https://typeittestit.com/",
};
---

<SiteLayout title={title} description={description} pageKey="home" structuredData={[webApplicationSchema, websiteSchema]}>
  <div class="relative min-h-screen">
    <Header client:idle />
    <main>
      <Hero />
      <div class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 lg:px-8" data-reveal="up">
        <TypingTesterIsland client:load />
      </div>
      <TypingMotionSection client:load />
      <div class="border-t border-hairline below-fold-content" data-reveal="up">
        <SeoContent />
      </div>
      <div class="border-t border-hairline below-fold-content" data-reveal="up">
        <HowItWorks />
      </div>
      <div class="border-t border-hairline below-fold-content" data-reveal="up">
        <FaqSection />
      </div>
    </main>
    <Footer />
    <FaqSchema />
  </div>
</SiteLayout>
