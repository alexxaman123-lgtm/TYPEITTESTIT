---
import SiteLayout from "../../layouts/SiteLayout.astro";
import KeyboardTester from "../../components/KeyboardTester";

const title = "Launch Full Keyboard Test | GOATTYPE";
const description = "Run the GOATTYPE always-on full keyboard test for letters, function keys, arrows, navigation keys, numpad, ghosting, and rollover.";
const canonicalPath = "/keyboard-test/tester/";
---
<SiteLayout title={title} description={description} canonicalPath={canonicalPath}>
  <div class="min-h-screen bg-page">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 pt-5 sm:px-6 lg:px-8">
      <a href="/" class="font-heading-5 text-ink">GOATTYPE 🐐</a>
      <a href="/keyboard-test/" class="rounded-full border border-hairline bg-canvas px-4 py-2 font-link text-ink transition-colors hover:border-text-muted">Keyboard test guide</a>
    </div>
    <main><KeyboardTester client:load /></main>
  </div>

  <script>
    const getKeyboardTester = () => document.querySelector<HTMLElement>('[role="application"][aria-label="Interactive full-size keyboard tester"]');

    const focusKeyboardTester = () => {
      const tester = getKeyboardTester();
      if (!tester || document.fullscreenElement) return;
      if (document.activeElement !== tester) tester.focus({ preventScroll: true });
    };

    const restoreTesterFocus = (event?: Event) => {
      const target = event?.target;
      if (target instanceof Element && target.closest('a[href]')) return;
      window.setTimeout(focusKeyboardTester, 0);
    };

    const captureForTester = (event: KeyboardEvent) => {
      if (!event.isTrusted) return;
      const tester = getKeyboardTester();
      if (!tester) return;

      // The launched route is exclusively a keyboard diagnostic. Blocking the
      // default at document capture phase prevents Space, arrows, Page Up,
      // Page Down, Home, End, Tab, Backspace and browser-handled F keys from
      // scrolling or moving focus before React receives the key event.
      event.preventDefault();

      if (event.target === tester) return;

      // If focus was moved to the page chrome, send an equivalent event to the
      // tester so the first key after focus loss is still counted. Synthetic
      // events are ignored above to avoid redispatch loops.
      event.stopPropagation();
      tester.focus({ preventScroll: true });
      tester.dispatchEvent(new KeyboardEvent(event.type, {
        key: event.key,
        code: event.code,
        location: event.location,
        ctrlKey: event.ctrlKey,
        shiftKey: event.shiftKey,
        altKey: event.altKey,
        metaKey: event.metaKey,
        repeat: event.repeat,
        isComposing: event.isComposing,
        bubbles: true,
        cancelable: true,
        composed: true,
      }));
    };

    window.addEventListener('load', () => {
      window.setTimeout(focusKeyboardTester, 50);
      window.setTimeout(focusKeyboardTester, 350);
    }, { once: true });
    window.addEventListener('focus', restoreTesterFocus);
    document.addEventListener('pointerup', restoreTesterFocus, true);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') restoreTesterFocus();
    });
    document.addEventListener('keydown', captureForTester, true);
    document.addEventListener('keyup', captureForTester, true);
  </script>
</SiteLayout>
