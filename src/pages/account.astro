---
import SiteLayout from "../layouts/SiteLayout.astro";
import Header from "../components/Header";
import Footer from "../components/Footer";
import AccountPage from "../components/AccountPage";

const title = "Typing History | GOATTYPE";
const description = "View your private typing test history, WPM, accuracy, and personal bests on GOATTYPE.";
---
<SiteLayout title={title} description={description} pageKey="account">
  <div class="relative min-h-screen">
    <Header client:idle />
    <AccountPage client:load />
    <Footer />
  </div>
</SiteLayout>
