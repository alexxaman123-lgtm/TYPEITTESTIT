---
import SiteLayout from "../layouts/SiteLayout.astro";
import Header from "../components/Header";
import TermsOfUsePage from "../components/TermsOfUsePage";
import Footer from "../components/Footer";

const title = "Terms of Use | FreeTypingTestGoat";
const description = "Read the FreeTypingTestGoat Terms of Use for the free online typing test, accounts, and leaderboard features.";
---
<SiteLayout title={title} description={description} canonicalPath="/terms-of-use">
  <div class="relative min-h-screen">
    <Header client:load />
    <main><TermsOfUsePage /></main>
    <Footer />
  </div>
</SiteLayout>
