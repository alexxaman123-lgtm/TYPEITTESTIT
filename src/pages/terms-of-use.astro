---
import SiteLayout from "../layouts/SiteLayout.astro";
import Header from "../components/Header";
import TermsOfUsePage from "../components/TermsOfUsePage";
import Footer from "../components/Footer";

const title = "Terms of Use | FreeTypingTestGoat";
const description = "Read the FreeTypingTestGoat Terms of Use covering free typing tests, accounts, leaderboard participation, acceptable use, and service responsibilities.";
---
<SiteLayout title={title} description={description} pageKey="terms-of-use">
  <div class="relative min-h-screen">
    <Header client:load />
    <main><TermsOfUsePage /></main>
    <Footer />
  </div>
</SiteLayout>
