const title="Kostenloser Schreibtest | WPM Tippgeschwindigkeit | GOATTYPE";
const description="Kostenloser Online-Schreibtest mit GOATTYPE: Miss Tippgeschwindigkeit, WPM, Genauigkeit und Fehler. 1-Minuten-Schreibtest sowie 2, 3 oder 5 Minuten – ohne Anmeldung.";
const webApplicationSchema={"@context":"https://schema.org","@type":"WebApplication",name:"GOATTYPE",alternateName:["Schreibtest","Kostenloser Schreibtest","Tippgeschwindigkeitstest"],url:"https://typeittestit.com/de/",inLanguage:"de",applicationCategory:"UtilityApplication",applicationSubCategory:"Schreibtest",operatingSystem:"Any",browserRequirements:"Erfordert einen modernen Webbrowser mit aktiviertem JavaScript",featureList:["Kostenloser Schreibgeschwindigkeitstest","WPM-Schreibtest","Tippgenauigkeitstest","Tippübung","1-Minuten-Schreibtest","2-Minuten-Schreibtest","3-Minuten-Schreibtest","5-Minuten-Schreibtest","Individueller Schreibtest"],description:"GOATTYPE ist ein kostenloses Online-Tool zum Messen der Schreibgeschwindigkeit in WPM, Genauigkeit und Fehlern.",offers:{"@type":"Offer",price:"0",priceCurrency:"USD"}};
const websiteSchema={"@context":"https://schema.org","@type":"WebSite",name:"GOATTYPE",alternateName:"Schreibtest",url:"https://typeittestit.com/de/",inLanguage:"de"};
---
