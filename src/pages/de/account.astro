---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Header from "../../components/Header";
import Footer from "../../components/Footer";
import AccountPage from "../../components/AccountPage";
const title = "Tippverlauf | Schreibtest Ziege";
const description = "Sieh deinen privaten Schreibtest-Verlauf, WPM, Genauigkeit und persönliche Bestleistungen auf Schreibtest Ziege.";
---
<SiteLayout title={title} description={description} pageKey="account" locale="de">
  <div class="relative min-h-screen"><Header client:idle locale="de" /><AccountPage client:load locale="de" /><Footer locale="de" /></div>
</SiteLayout>
