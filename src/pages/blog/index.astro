---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Header from "../../components/Header";
import Footer from "../../components/Footer";

const title = "Typing Tips & Resources | FreeTypingTestGoat Blog";
const description = "Practical guides on improving your typing speed, understanding WPM benchmarks, and fixing common touch-typing mistakes.";

const posts = [
  {
    href: "/blog/how-to-increase-typing-speed/",
    title: "How to Increase Your Typing Speed: A Complete WPM Improvement Guide",
    description: "A step-by-step guide to building real typing speed without sacrificing accuracy, using deliberate practice and the right settings.",
  },
  {
    href: "/blog/good-typing-speed-benchmarks/",
    title: "What Is a Good Typing Speed? WPM Benchmarks by Age, Job, and Skill Level",
    description: "See how your words-per-minute compares across skill tiers, professions, and age groups, and learn how to set a realistic target.",
  },
  {
    href: "/blog/touch-typing-mistakes/",
    title: "10 Touch Typing Mistakes That Are Slowing You Down (and How to Fix Them)",
    description: "The most common habits that quietly cap your typing speed, and concrete fixes for each one.",
  },
];
---
<SiteLayout title={title} description={description} canonicalPath="/blog/">
  <div class="relative min-h-screen">
    <Header client:load />
    <main>
      <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
        <p class="font-label text-accent">Blog</p>
        <h1 class="mt-3 font-heading-3 text-ink">Typing Tips &amp; Resources</h1>
        <p class="mt-4 font-body text-text-muted">Short, practical guides to help you type faster and more accurately, backed by the same metrics FreeTypingTestGoat measures in every test.</p>
        <div class="mt-10 flex flex-col gap-6">
          {posts.map((post) => (
            <a href={post.href} class="block rounded-[24px] border border-hairline bg-canvas p-6 shadow-sm transition-colors hover:border-accent/40 sm:p-8">
              <h2 class="font-heading-4 text-ink">{post.title}</h2>
              <p class="mt-3 font-body text-text-muted">{post.description}</p>
              <span class="mt-4 inline-block font-link text-accent">Read article →</span>
            </a>
          ))}
        </div>
      </section>
    </main>
    <Footer />
  </div>
</SiteLayout>
