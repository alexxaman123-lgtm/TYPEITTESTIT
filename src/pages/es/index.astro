---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Header from "../../components/Header";
import TypingTesterIsland from "../../components/TypingTesterIsland";
import SpanishHero from "../../components/SpanishHero";
import SpanishSeoContent from "../../components/SpanishSeoContent";
import SpanishHowItWorks from "../../components/SpanishHowItWorks";
import SpanishFaqSection from "../../components/SpanishFaqSection";
import SpanishFaqSchema from "../../components/SpanishFaqSchema";
import Footer from "../../components/Footer";

const title = "Test de mecanografía gratis online | WPM y práctica de mecanografía | FreeTypingTestGoat";
const description = "Haz un test de mecanografía gratis online para medir velocidad de escritura, WPM, precisión y errores. Practica con pruebas de 1, 2, 3 o 5 minutos.";

const alternates = [
  { hreflang: "en", href: "https://typeittestit.com/" },
  { hreflang: "es", href: "https://typeittestit.com/es/" },
  { hreflang: "x-default", href: "https://typeittestit.com/" },
];

const webApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "FreeTypingTestGoat",
  alternateName: ["Test de mecanografía", "Test de mecanografía gratis", "Test de mecanografía online"],
  url: "https://typeittestit.com/es/",
  inLanguage: "es",
  applicationCategory: "UtilityApplication",
  applicationSubCategory: "Typing Test",
  operatingSystem: "Any",
  browserRequirements: "Requiere un navegador web moderno con JavaScript habilitado",
  featureList: [
    "Test de mecanografía gratis",
    "Test de mecanografía online",
    "Prueba de mecanografía",
    "Test de velocidad de escritura",
    "WPM y palabras por minuto",
    "Seguimiento de precisión",
    "Test de mecanografía de 1 minuto",
    "Test de mecanografía de 2 minutos",
    "Test de mecanografía de 3 minutos",
    "Test de mecanografía de 5 minutos",
    "Test de mecanografía personalizado",
  ],
  description: "FreeTypingTestGoat es un test de mecanografía online gratis para medir velocidad de escritura, WPM, precisión y errores.",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "FreeTypingTestGoat",
  alternateName: "Test de mecanografía",
  url: "https://typeittestit.com/",
  inLanguage: "es",
};
---

<SiteLayout title={title} description={description} canonicalPath="/es/" locale="es" alternates={alternates} structuredData={[webApplicationSchema, websiteSchema]}>
  <div class="relative min-h-screen">
    <Header client:load />
    <main>
      <SpanishHero />
      <div class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 lg:px-8" data-reveal="up">
        <TypingTesterIsland client:load />
      </div>
      <div class="border-t border-hairline below-fold-content" data-reveal="up"><SpanishSeoContent /></div>
      <div class="border-t border-hairline below-fold-content" data-reveal="up"><SpanishHowItWorks /></div>
      <div class="border-t border-hairline below-fold-content" data-reveal="up"><SpanishFaqSection /></div>
    </main>
    <Footer />
    <SpanishFaqSchema />
  </div>
</SiteLayout>
