---
import SiteLayout from "../layouts/SiteLayout.astro";
import Header from "../components/Header";
import Footer from "../components/Footer";
import KeyboardTester from "../components/KeyboardTester";

const title = "Keyboard Tester Online – Test All Keys & Numpad | GOATTYPE";
const description = "Use GOATTYPE's free online keyboard tester to test every key, function keys, arrows, navigation controls, number pad, ghosting, and simultaneous key input.";
const canonicalPath = "/keyboard-test/";
const faqItems = [
  ["How can I test whether my keyboard is working properly?", "Click inside the tester and press every physical key. Working keys light up and stay marked after release. Test letters, numbers, modifiers, function keys, navigation keys, arrows, and the numeric keypad."],
  ["Can this keyboard tester check the number pad?", "Yes. It includes Num Lock, operators, Enter, decimal, and number-pad digits 0 through 9. Toggle Num Lock if the keypad reports navigation behavior."],
  ["How do I test F1–F12 and the F6 key?", "Focus the tester and press the function key. Compact laptops may require Fn or Fn Lock. A browser or operating system may still reserve some function-key shortcuts."],
  ["Can a keyboard tester detect ghosting?", "It can help identify practical ghosting or rollover limits. Hold several keys together and compare the highlighted keys with the Held now counter."],
  ["How do I diagnose a key that works only sometimes?", "Reset the tester and press the suspect key repeatedly. Intermittent input can result from debris, a worn switch, a loose cable, low wireless battery, interference, or software remapping."],
  ["What should I do if my keyboard is not typing?", "Reconnect it, try another port, check batteries and input language, restart the device, and test another application. Also inspect Fn Lock and accessibility settings such as Filter Keys."],
  ["Can I test an HP, Dell, Lenovo, Mac, or external keyboard?", "Yes. It works with most laptop, desktop, mechanical, membrane, Bluetooth, and USB keyboards that provide standard browser keyboard events."],
  ["How do I know whether my laptop keyboard is physically damaged?", "A key that fails across browsers and applications after cleaning and restarting is more likely to have a hardware problem. Sticking, double input, liquid exposure, or several keys failing together are additional warning signs."],
  ["Can keyboard keys be replaced?", "Many desktop keycaps and mechanical switches are replaceable. Laptop keycaps are model-specific and delicate, so consult the service manual or an authorized repair provider."],
  ["Does the keyboard test record what I type?", "No. The test runs locally in the browser and does not save your keystrokes."],
];
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "GOATTYPE Online Keyboard Tester",
    url: "https://typeittestit.com/keyboard-test/",
    applicationCategory: "UtilityApplication",
    operatingSystem: "Any",
    browserRequirements: "Requires a modern browser with JavaScript enabled",
    description,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map(([name, text]) => ({
      "@type": "Question",
      name,
      acceptedAnswer: { "@type": "Answer", text },
    })),
  },
];
---
<SiteLayout title={title} description={description} canonicalPath={canonicalPath} structuredData={structuredData}>
  <div class="relative min-h-screen">
    <Header client:idle />
    <main><KeyboardTester client:load /></main>
    <Footer />
  </div>
</SiteLayout>
