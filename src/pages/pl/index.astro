const webApplicationSchema={"@context":"https://schema.org","@type":"WebApplication",name:"Test Pisania Koza",alternateName:["Test pisania","Darmowy test pisania","Test szybkości pisania"],url:"https://typeittestit.com/pl/",inLanguage:"pl",applicationCategory:"UtilityApplication",applicationSubCategory:"Test pisania",operatingSystem:"Any",browserRequirements:"Wymaga nowoczesnej przeglądarki z włączoną obsługą JavaScript",featureList:["Darmowy test szybkości pisania","Test pisania WPM","Test dokładności pisania","Trening pisania","Test pisania 1 minuta","Test pisania 2 minuty","Test pisania 3 minuty","Test pisania 5 minut","Niestandardowy test pisania"],description:"Test Pisania Koza to darmowe narzędzie online do mierzenia szybkości pisania w WPM, dokładności i błędów.",offers:{"@type":"Offer",price:"0",priceCurrency:"USD"}};
