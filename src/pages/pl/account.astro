---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Header from "../../components/Header";
import Footer from "../../components/Footer";
import AccountPage from "../../components/AccountPage";
const title = "Historia pisania | Test Pisania Koza";
const description = "Zobacz swoją prywatną historię testów pisania, WPM, dokładność i najlepsze wyniki w Test Pisania Koza.";
---
<SiteLayout title={title} description={description} pageKey="account" locale="pl">
  <div class="relative min-h-screen"><Header client:idle locale="pl" /><AccountPage client:load locale="pl" /><Footer locale="pl" /></div>
</SiteLayout>
