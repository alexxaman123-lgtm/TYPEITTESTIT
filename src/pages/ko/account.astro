---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Header from "../../components/Header";
import Footer from "../../components/Footer";
import AccountPage from "../../components/AccountPage";
const title = "타이핑 기록 | 타이핑 테스트 염소";
const description = "타이핑 테스트 염소에서 나의 개인 타이핑 테스트 기록, WPM, 정확도, 최고 기록을 확인하세요.";
---
<SiteLayout title={title} description={description} pageKey="account" locale="ko">
  <div class="relative min-h-screen"><Header client:idle locale="ko" /><AccountPage client:load locale="ko" /><Footer locale="ko" /></div>
</SiteLayout>
