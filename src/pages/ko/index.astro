---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Header from "../../components/Header";
import TypingTesterIsland from "../../components/TypingTesterIsland";
import Hero from "../../components/Hero";
import TypingMotionSection from "../../components/TypingMotionSection";
import SeoContent from "../../components/SeoContent";
import HowItWorks from "../../components/HowItWorks";
import FaqSection from "../../components/FaqSection";
import FaqSchema from "../../components/FaqSchema";
import Footer from "../../components/Footer";
const title="밌로 온달지 파미로 링 온달지 로붰버막 큼 묎게 달로붰묎뫉 게 밌로온달지";
const description="placeholder";
const webApplicationSchema={};
const websiteSchema={};
---
<SiteLayout title={title} description={description} pageKey="home" locale="ko" structuredData={[webApplicationSchema,websiteSchema]}><div class="relative min-h-screen"><Header client:idle locale="ko"/><main><Hero locale="ko"/><div class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 lg:px-8" data-reveal="up"><TypingTesterIsland client:load locale="ko"/></div><TypingMotionSection client:visible locale="ko"/><div class="border-t border-hairline below-fold-content" data-reveal="up"><SeoContent locale="ko"/></div><div class="border-t border-hairline below-fold-content" data-reveal="up"><HowItWorks locale="ko"/></div><div class="border-t border-hairline below-fold-content" data-reveal="up"><FaqSection locale="ko"/></div></main><Footer locale="ko"/><FaqSchema locale="ko"/></div></SiteLayout>
